{
  "name": "stratagem-ai-counter-engine",
  "version": "3.0.0",
  "private": true,
  "description": "Predictive Counter-Strategy Game Engine powered by Chessformer (Maia-3), Bayesian Opponent Modeling, GenBR IS-MCTS, and Dynamic Spatial Influence Simulation",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build:wasm": "wasm-pack build rust-kernel --target web --out-dir ../src/wasm-pkg",
    "build": "npm run build:wasm && tsc && vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xstate": "^5.18.0",
    "@xstate/react": "^4.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.49",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}